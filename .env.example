# BrickFly accounts + cloud save.
# Copy to `.env.local` for local dev, or add these in Vercel → Project → Settings → Environment Variables.
# The game runs fine with NONE of these set — accounts simply stay disabled until they are.

# --- Database (Neon Postgres) -------------------------------------------------
# Add the Neon integration in Vercel (Storage → add Neon) or copy the pooled
# connection string from the Neon dashboard. Use the POOLED URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js core -------------------------------------------------------------
# Generate with:  npx auth secret   (or)  openssl rand -base64 33
AUTH_SECRET="replace-with-a-long-random-string"

# --- Google sign-in (optional) ------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- GitHub sign-in (optional) ------------------------------------------------
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
# Authorization callback URL: https://YOUR_DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
